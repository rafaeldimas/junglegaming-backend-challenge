# Runtime configuration. Every variable has a safe local default in
# src/config/env.ts; copy this file to `.env` to override them locally.

# --- HTTP -------------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- PostgreSQL -------------------------------------------------------------
DATABASE_URL=postgresql://jungle:jungle@localhost:5432/jungle

# --- SQS (LocalStack by default) -------------------------------------------
SQS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

SQS_QUEUE_NAME=wager-transactions.fifo
SQS_DLQ_NAME=wager-transactions-dlq.fifo
# Outbound integration events (the outbox publisher writes here).
SQS_EVENTS_QUEUE_NAME=wager-events.fifo

SQS_WAIT_TIME_SECONDS=20
SQS_VISIBILITY_TIMEOUT_SECONDS=30
SQS_MAX_ATTEMPTS=5
SQS_CONSUMER_ENABLED=true
# Create the queues on boot when they are missing (development only).
QUEUE_AUTO_CREATE=true

# --- Outbox publisher -------------------------------------------------------
OUTBOX_PUBLISHER_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=100
OUTBOX_BATCH_SIZE=200
OUTBOX_PUBLISH_CONCURRENCY=8

# --- PENDING_REFERENCE worker ----------------------------------------------
PENDING_REFERENCE_WORKER_ENABLED=true
PENDING_REFERENCE_POLL_INTERVAL_MS=5000
PENDING_REFERENCE_BATCH_SIZE=50
PENDING_REFERENCE_MAX_ATTEMPTS=5
PENDING_REFERENCE_TTL_MINUTES=15

# --- Graceful shutdown ------------------------------------------------------
SHUTDOWN_GRACE_MS=10000
